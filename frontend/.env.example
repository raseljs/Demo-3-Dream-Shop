# URL the Next.js server uses to reach the API (can be internal, e.g. http://127.0.0.1:5000)
API_URL=https://api.yourshop.com
# Public URL of the API (used for product images in the browser)
NEXT_PUBLIC_API_URL=https://api.yourshop.com
# Public URL of this storefront (SEO: sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://yourshop.com
# Must match REVALIDATE_SECRET in backend/.env (instant cache refresh after admin edits)
REVALIDATE_SECRET=change-this-too-same-as-backend
