# ---- Server ----
PORT=5000
# Bangladesh time (UTC+6) — used for order dates & reports
TZ_OFFSET_HOURS=6

# ---- Database ----
# mysql  = production / cPanel (MySQL or MariaDB)
# sqlite = local testing without installing MySQL (needs Node.js 22.13+)
DB_CLIENT=mysql

# MySQL / MariaDB (cPanel > MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ---- Security (use long random strings) ----
JWT_SECRET=change-this-to-a-long-random-string
REVALIDATE_SECRET=change-this-too-same-as-frontend

# ---- URLs ----
# Public URL of this API (used for payment callbacks & image links)
BACKEND_URL=https://api.yourshop.com
# Public URL of the Next.js storefront (used for redirects & cache refresh)
FRONTEND_URL=https://yourshop.com

# ---- First admin account (created by `npm run migrate`) ----
ADMIN_NAME=Admin
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=admin12345
